# Copy to .env next to compose.yml and fill in. .env stays on the server: git ignores it.

# The server's address as the router dials it. The TLS certificate names it.
PUBLIC_ADDR=203.0.113.5

# The router's address as it arrives at the server: comma-separated IPs or CIDRs. Nothing
# else can send lines in, over UDP or TLS.
ALLOW=198.51.100.7

# Where to listen. UDP=off turns UDP off; an empty TLS= turns TLS off.
UDP=:5514
TLS=:6514

# The user and group the container runs as: the owner of ./data.
RUN_AS=1000:1000
