# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Locally-installed third-party skills (e.g. via `npx skills add`) — kept local, not published
.claude/skills/
.agents/
skills-lock.json

# Raw CUBE captures (syslog, debug output, pcaps) contain sensitive data — never commit.
# Only sanitized, reviewed fixtures go into testdata/.
captures/
*.log
*.pcap
*.pcapng

# A server deployment's own files: its real addresses, its certificates and CA key, and the
# binary built for it. deploy/env.example is the template that is committed.
deploy/.env
deploy/data/
deploy/cube-logger
